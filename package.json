{
  "name": "@spala-ai/agent-integrations",
  "version": "1.3.0",
  "private": true,
  "description": "Official Spala plugins and extensions for leading AI coding agents.",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "check:skills": "node scripts/sync-skills.mjs --check",
    "check:skill-release": "node scripts/check-skill-release.mjs",
    "test:links": "node scripts/check-links.mjs",
    "test:links:release": "CHECK_REPOSITORY_URL=1 node scripts/check-links.mjs",
    "ci": "pnpm test && pnpm validate && pnpm check:skills && pnpm check:skill-release"
  },
  "engines": {
    "node": ">=20"
  },
